{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "global",
  "compatibility_date": "2024-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_DO",
        "class_name": "AuthStorage"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthStorage"]
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "to-trust",
      "database_id": "6f7f17e5-74a6-46a1-a424-a1e5b0cb7284"
    }
  ]
}
